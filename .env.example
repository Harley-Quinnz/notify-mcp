# Bu dosyayı ".env" adıyla kopyalayın ve kendi bilgilerinizle doldurun:
#   cp .env.example .env        (macOS / Linux / Git Bash)
#   copy .env.example .env      (Windows CMD / PowerShell)
#
# .env dosyası .gitignore ile hariç tutulur; asla commit etmeyin.

# Gmail adresiniz. Bildirimler bu adresten yine bu adrese gönderilir.
EMAIL_USER=ornek@gmail.com

# Gmail "Uygulama Şifresi" (normal hesap şifreniz DEĞİL).
# Oluşturmak için: https://myaccount.google.com/apppasswords
# (Hesabınızda 2 Adımlı Doğrulama açık olmalıdır. Boşluklu yazabilirsiniz.)
EMAIL_PASS=xxxx xxxx xxxx xxxx
